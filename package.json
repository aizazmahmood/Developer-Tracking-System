{
  "name": "desktop-tracker",
  "productName": "Developer Work Tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Unverified static desktop shell for Developer Work Tracker",
  "license": "UNLICENSED",
  "main": ".webpack/main/index.cjs",
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": ">=11.14.1 <12"
  },
  "packageManager": "npm@11.14.1",
  "scripts": {
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --config vitest.config.mts",
    "test:candidates": "vitest run --config vitest.candidates.config.mts",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-webpack": "8.0.1",
    "@eslint/js": "9.39.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "css-loader": "7.1.5",
    "electron": "45.2.3",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "26.1.0",
    "mini-css-extract-plugin": "2.10.2",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "webpack": "5.112.2"
  }
}
